# Use a separate copy of this file and a separate HISTORY_SCHEMA for each chain.
HISTORY_TOOLS_IMAGE=ghcr.io/fullon-labs/floncore/history-tools:0.8.0-alpha
HISTORY_TOOLS_VERSION=0.8.0-alpha
POSTGRES_IMAGE=postgres:15-bookworm

# This must be the SHiP endpoint, not the funod HTTP RPC endpoint.
SHIP_ENDPOINT=host.docker.internal:19555
HISTORY_SCHEMA=flon_testnet

POSTGRES_DB=flon_history
POSTGRES_USER=flon_history
POSTGRES_PASSWORD_FILE=./secrets/postgres_password

FILL_MAX_MESSAGES_IN_FLIGHT=1024
FILL_ACK_BATCH_SIZE=256
FILL_TRIM=false

# FullOn may take up to 12 seconds to produce a block when idle. Keep this
# comfortably above that interval to avoid false unhealthy states.
HISTORY_STALE_SECONDS=90
